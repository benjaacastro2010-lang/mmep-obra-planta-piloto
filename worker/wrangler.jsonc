{
  "name": "mmep-obras",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // La página se sirve en mmepconstructora.com/obra/ (carpeta ../obra); lo que no es un archivo va al Worker (API)
  "assets": { "directory": "..", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "routes": [
    { "pattern": "mmepconstructora.com/obra*", "zone_name": "mmepconstructora.com" },
    { "pattern": "www.mmepconstructora.com/obra*", "zone_name": "mmepconstructora.com" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "mmep-obras", "database_id": "82716cce-e56a-410e-8c7d-7e823075c9f2" }
  ]
}
